# Brewfile — apps installable via Homebrew
# Usage: brew bundle --file=Brewfile

# --- Command-line tools ---
brew "gh"              # GitHub CLI: `gh auth login` sets up SSH key + keychain (setup-01)
brew "pandoc"          # Document conversion, e.g. md -> docx (setup-03)

# --- Apps ---
cask "google-chrome"
cask "whatsapp"
cask "onedrive"
cask "visual-studio-code"
cask "claude"          # Claude desktop app
cask "logi-options+"   # Logitech MX Keys: remap the screenshot key (needs a reboot)
cask "maccy"           # Clipboard manager with searchable history (setup-04)

