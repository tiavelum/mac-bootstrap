# Git aliases — originally collected on Windows, ported to macOS 2026-07-26.
# Source: "git alias" email from 2026-04-29.
# Fixes applied during port:
#   - latest-tag: repaired corrupted "--sort=-creatordate"
#   - clean-them-all: added missing "git" before clean-tracked-recursive
#   - squash-n: removed Windows over-escaping of quotes
#   - show-log / show-log-recursive: added ";" before closing brace (sh syntax)
#
# Activate with:
#   git config --global include.path ~/mac-setup/gitconfig-aliases

[alias]
	a = ad
	aa = add .
	ad = add
	al = alias
	alias = "!f() { git cfgget alias.$1 | sed -e \"s/alias.//\"; }; f"
	au = authors
	authors = shortlog -e -s -n
	b = br
	bd = br -D
	br = branch
	ca = commit -a -m
	cam = commit --amend -m
	cfg = config --list
	cfgget = get-config
	cl = clone
	clean-them-all = "!git clean-untracked-recursive && git clean-tracked-recursive"
	clean-tracked = reset --hard
	clean-tracked-recursive = "!git clean-tracked && git submodule foreach --recursive git clean-tracked"
	clean-untracked = clean -xfd
	clean-untracked-recursive = "!git clean-untracked && git submodule foreach --recursive git clean-untracked"
	cm = commit -m
	co = checkout
	cod = co develop
	codp = "! git cod; git pl"
	com = "! git co master || git co main"
	commits-since-tag = "!f() { git rev-list $1..HEAD --count; }; f"
	comp = "! git com; git pl"
	cp = cherry-pick
	cr = crec
	crec = cl --recursive
	crl = cron
	cron = cronlog
	cronlog = "log --graph --pretty=\"format:%C(red)%d%C(reset) %C(yellow)%h%C(green) %ar %C(bold blue)%aN%C(reset) %s\""
	cstag = commits-since-tag
	d = df
	df = dif
	dif = diff
	esl = essential-log
	essential-log = "log --graph --pretty=format:\"commit: %C(bold red)%h%Creset %C(red)<%H>%Creset %C(bold magenta)%d %Creset%ndate: %C(bold yellow)%cd %Creset%C(yellow)%cr%Creset%nauthor: %C(bold blue)%an%Creset %C(blue)<%ae>%Creset%n%C(cyan)%s%n%Creset\""
	get-config = "!f() { color=$(tput setaf 6); reset=$(tput sgr0); git config --get-regexp \"^$1\" | sed -e \"s/^$1/${color}$1/\" -e \"s/ /${reset}  /\" | sort; }; f"
	highest-tag = "!f() { git stag | tail -n 1; }; f"
	hil = hist
	hist = histlog
	histlog = "log --color --graph --pretty=format:\"%C(yellow)%h%Creset -%C(red)%d%Creset %s %Cgreen(%cr) %C(bold blue)<%an>%Creset\" --abbrev-commit"
	hitag = highest-tag
	i = in
	in = init
	l = log
	lal = last
	last = lastlog
	lastlog = "log -1 --pretty=format:\"commit: %C(bold red)%h%Creset %C(red)<%H>%Creset %C(bold magenta)%d %Creset%ndate: %C(bold yellow)%cd %Creset%C(yellow)%cr%Creset%nauthor: %C(bold blue)%an%Creset %C(blue)<%ae>%Creset%n%n%C(bold cyan)%s%n%n%C(cyan)%b%n%Creset\""
	latest-branch-tag = describe --tags --abbrev=0
	latest-tag = "!f() { git for-each-ref --sort=-creatordate --format=\"%(refname:short)\" refs/tags | head -n 1; }; f"
	lbtag = latest-tag
	lotag = lowest-tag
	lowest-tag = "!f() { git srtag | tail -n 1; }; f"
	ltag = latest-tag
	oldest-tag = "!f() { git for-each-ref --sort=creatordate --format=\"%(refname:short)\" refs/tags | head -n 1; }; f"
	otag = oldest-tag
	pk = cp
	pl = pull
	pn = push-new
	po = pl origin
	pod = po develop
	pom = po master
	ps = push
	psat = push-all-tags
	psf = ps
	pso = ps origin
	pst = push-tag
	pul = pl
	pus = ps
	push-all-tags = push origin --tags
	push-new = "!f() { current=`git branch --show-current` ; git push --set-upstream origin $current; }; f"
	push-tag = push origin
	rb = remote-branches
	remote-branches = "!f() { red=$(tput setaf 1); reset=$(tput sgr0); rbs=`git b -r | sed \"s/origin\\\\///g\"`; echo \"${red}$rbs${reset}\"; }; f"
	rlog = reflog
	rpo = remote prune origin
	rv = revert
	sc = sw -c
	sh = show
	shl = show-log
	shlrec = show-log-recursive
	short-log = shortlog
	short-show = "!git log --oneline -1"
	short-show-rec = "!git short-show && git submodule foreach --recursive git short-show"
	show-log = "!f() { git short-show; if [ -n \"$1\" ]; then lines=$1; shift; git shortlog \"$@\" | head -n \"$lines\"; else git shortlog \"$@\"; fi; }; f"
	show-log-recursive = "!f() { git short-show; if [ -n \"$1\" ]; then lines=$1; shift; git shortlog \"$@\" | head -n \"$lines\" && git submodule foreach --recursive git shortlog \"$@\" | head -n \"$lines\"; else git shortlog \"$@\" && git submodule foreach --recursive git shortlog \"$@\"; fi; }; f"
	shsh = short-show
	shshrec = short-show-rec
	sort-reverse-tag = "!f() { git tag | sort -Vr; }; f"
	sort-tag = "!f() { git tag | sort -V; }; f"
	sq = sqn
	sqb = squash-branch
	sqn = squash-n
	squash-branch = "!f() { branch=$1; shift; root=$(git merge-base $branch HEAD); git reset --soft $root && git commit; }; f"
	squash-n = "!f() { n=\"$1\"; shift; git reset --soft HEAD~$n && git commit -m \"$*\"; }; f"
	srtag = sort-reverse-tag
	ss = submodule status
	st = status
	stag = sort-tag
	stats = statslog
	statslog = log --stat --graph --pretty=oneline --abbrev-commit --date=relative
	statusrec = "!git st && git sust"
	stl = stats
	su = submodule update
	suir = su --init --recursive
	surr = su --remote --recursive
	sust = submodule foreach --recursive git status
	sw = switch
	ta = track-all
	tb = track-basic
	to = track-only
	track-all = "!f() { git branch -r | grep -v \"\\\\->\" | while read remote; do git branch --track ${remote#origin/} $remote; done; }; f"
	track-basic = "!f() { current=`git branch --show-current`; git to; git com --; git cod --; git rpo; git co $current; }; f"
	track-only = "!f() { allbranches=`git branch | tr \"*\" \" \"`; git branch -D $allbranches; }; f"
	tree = treelog
	treelog = log --oneline --graph --decorate --all
	trl = tree
	uc = uncommit
	ud = undo
	uncommit = reset --soft HEAD^
	undo = checkout --
	unstagefile = reset HEAD --
	us = unstagefile
	yel = yest
	yest = yestlog
	yestlog = "log --graph --pretty=\"format:%Cred%d%Creset %C(yellow) %h%Cgreen %ad %C(bold blue)%aN%Creset %s\" --since=\"yesterday\""
